# Kolo backend (NestJS global prefix /api)
VITE_API_URL=http://localhost:3000/api

# Clerk publishable key — https://dashboard.clerk.com → API Keys → "Publishable key".
# Starts with pk_test_ (development instance) or pk_live_ (production).
# Leave EMPTY to keep the dev e-mail login (backend DEV_AUTH_BYPASS=true) and the
# seeded demo accounts. Fill it in and the app switches to Clerk's own <SignIn>.
# The matching CLERK_SECRET_KEY lives in the BACKEND .env — same Clerk instance.
VITE_CLERK_PUBLISHABLE_KEY=
